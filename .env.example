# Copiar a .env y completar. NUNCA commitear el archivo .env real.

# Clave de API de Anthropic (https://platform.claude.com). Si no se define,
# la suite corre automaticamente en modo demo (mock), sin llamadas externas.
ANTHROPIC_API_KEY=

# Modelo a utilizar (opcional, por defecto claude-opus-5)
ENTERPRISE_AGENTS_MODEL=claude-opus-5

# Maximo de iteraciones del bucle agentico por consulta (opcional)
ENTERPRISE_AGENTS_MAX_ITERATIONS=8
